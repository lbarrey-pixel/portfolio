---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { getContent } from '../content';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta } = getContent(locale);
const htmlLang = locale === 'pt-br' ? 'pt-BR' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="pt-BR" href="/pt-br/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="theme-color" content="#efece3" />
    <Font cssVariable="--font-schibsted" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-newsreader" preload={[{ weight: '400', style: 'italic' }]} />
    <Font cssVariable="--font-spline-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>
