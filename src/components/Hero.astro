---
import { SITE } from '../config';
import { getContent } from '../content';
import type { Locale } from '../i18n/locales';
import { whatsappUrl } from '../lib/contact';
import HeroMap from './HeroMap.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const waHref = whatsappUrl(SITE.phoneE164, c.contact.whatsappMessage);
const quoting = c.work.projects[0];
const lines = c.hero.headline.length;
---

<section id="hero" class="hero">
  <div class="wrap hero__inner">
    <p class="hero__tag">{c.hero.tag}</p>

    <h1 class="hero__title">
      {
        c.hero.headline.map((line, i) => (
          <span class="hero__line" style={`--n:${i}`}>
            <span>{line}</span>
          </span>
        ))
      }
      <span class="hero__line hero__line--accent" style={`--n:${lines}`}>
        <span class="accent">{c.hero.accent}</span>
      </span>
    </h1>

    <div class="hero__aside">
      <span class="hero__cue" aria-hidden="true"></span>
      <p class="hero__lead">{c.hero.lead}</p>
      <div class="hero__ctas">
          <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener" data-cta="whatsapp" data-magnetic>
            {c.hero.ctaPrimary}
          </a>
          <a class="btn btn--ghost" href="#work" data-magnetic>{c.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero__map">
      <HeroMap caption={quoting.tab} steps={quoting.steps} log={c.hero.mapLog} />
    </div>
  </div>
</section>

<script>
  // Magnetic buttons: they lean toward a fine pointer, and settle back when it leaves.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !reduced) {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) * 0.22;
        const y = (e.clientY - r.top - r.height / 2) * 0.35;
        el.style.translate = `${x.toFixed(1)}px ${y.toFixed(1)}px`;
      });
      el.addEventListener('pointerleave', () => {
        el.style.translate = '';
      });
    });
  }
</script>

<style>
  .hero {
    padding-block: clamp(var(--space-6), 6vh, var(--space-8)) var(--space-7);
  }

  .hero__inner {
    --gap: var(--space-5);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
  }

  .hero__tag {
    grid-column: 1 / -1;
    font: 400 var(--step--1) / 1.4 var(--font-mono);
    color: var(--acc);
    animation: fade 0.9s var(--ease-out) 0.05s both;
  }

  /* Headline: a staircase. Each line steps in one column, like the flow below it. */
  .hero__title {
    grid-column: 1 / -1;
    /* one grid column (plus its gap), so each step lands exactly on the grid */
    --stair: calc((100% + var(--gap)) / 12);
    margin-top: var(--space-4);
    font: 500 var(--step-hero) / 0.98 var(--font-body);
    letter-spacing: -0.04em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-left: calc(var(--n) * var(--stair));
  }

  .hero__line > span {
    display: inline-block;
    animation: rise 1.15s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--n) * 0.11s);
  }

  .hero__line--accent {
    padding-bottom: 0.12em;
  }

  .hero__line--accent .accent {
    font-size: 1.12em;
    line-height: 0.9;
    letter-spacing: -0.025em;
  }

  .hero__aside {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: end;
    margin-top: var(--space-5);
  }

  .hero__lead {
    grid-column: 3 / span 6;
    grid-row: 1;
    max-width: 56ch;
    animation: fade 1s var(--ease-out) 0.55s both;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--mute);
  }

  .hero__ctas {
    grid-column: 9 / -1;
    grid-row: 1;
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    animation: fade 1s var(--ease-out) 0.65s both;
  }

  /* Scroll cue: a hairline with a drop running down it. */
  .hero__cue {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    justify-self: start;
    position: relative;
    width: 1px;
    height: 3.5rem;
    overflow: hidden;
    background: var(--line);
    animation: fade 1s var(--ease-out) 0.8s both;
  }

  .hero__cue::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--ink);
    animation: cue 2s var(--ease-in-out) infinite;
  }

  .hero__map {
    grid-column: 1 / -1;
    margin-top: var(--space-6);
    animation: fade 1.1s var(--ease-out) 0.7s both;
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes cue {
    to {
      top: 100%;
    }
  }

  @media (max-width: 63.99rem) {
    .hero__lead,
    .hero__ctas {
      grid-column: 2 / -1;
    }

    .hero__ctas {
      grid-row: 2;
      justify-self: start;
      margin-top: var(--space-5);
    }
  }

  @media (max-width: 47.99rem) {
    .hero__title {
      font-size: clamp(2.4rem, 0.9rem + 7.2vw, 3.4rem);
      line-height: 1;
    }

    .hero__line {
      margin-left: 0;
    }

    .hero__line--accent {
      margin-left: 0;
    }

    .hero__lead,
    .hero__ctas {
      grid-column: 1 / -1;
    }

    .hero__cue {
      display: none;
    }

    .hero__ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>
