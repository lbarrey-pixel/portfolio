---
// Page body. Work and Try it are plain until their tasks build them.
import { getContent, type Metric } from '../content';
import type { Locale } from '../i18n/locales';
import { formatNumber } from '../lib/format';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Method from './Method.astro';
import Nav from './Nav.astro';
import Pains from './Pains.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const metricText = (m: Metric) => `${m.prefix ?? ''}${formatNumber(m.value, locale)}${m.suffix ?? ''}`;
---

<Nav locale={locale} />

<main>
  <Hero locale={locale} />
  <Marquee items={c.stack} label="Stack" />

  <Pains locale={locale} />

  <section id="work">
    <p>{c.work.eyebrow}</p>
    <h2>{c.work.title}</h2>
    <p>{c.work.lead}</p>
    {
      c.work.projects.map((p) => (
        <article id={`project-${p.id}`}>
          <p>{p.kind}</p>
          <h3>{p.title}</h3>
          <p>{p.summary}</p>
          <ol>
            {p.steps.map((s) => (
              <li>
                {s.code} {s.title} ({s.tech})
              </li>
            ))}
          </ol>
          <ul>
            {p.bullets.map((b) => (
              <li>
                <strong>{b.label}:</strong> {b.text}
              </li>
            ))}
          </ul>
          <dl>
            {p.metrics.map((m) => (
              <div>
                <dt>{metricText(m)}</dt>
                <dd>{m.label}</dd>
              </div>
            ))}
          </dl>
          <ul>{p.tags.map((t) => <li>{t}</li>)}</ul>
          <p>{p.status}</p>
          <a href={`#demo-${p.id}`}>{p.tryLabel}</a>
        </article>
      ))
    }
  </section>

  <section id="try">
    <p>{c.tryIt.eyebrow}</p>
    <h2>{c.tryIt.title}</h2>
    <p>{c.tryIt.lead}</p>
    {
      c.work.projects.map((p) => (
        <div id={`demo-${p.id}`}>
          <h3>{p.tab}</h3>
          <ul>{c.tryIt.hints[p.id].map((h) => <li>{h}</li>)}</ul>
          <p>{c.tryIt.fakeNote[p.id]}</p>
        </div>
      ))
    }
  </section>

  <Method locale={locale} />
  <About locale={locale} />
  <Contact locale={locale} />
</main>

<Footer locale={locale} />
