---
// Page body: every section, in page order.
import { getContent } from '../content';
import type { Locale } from '../i18n/locales';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Method from './Method.astro';
import Nav from './Nav.astro';
import Pains from './Pains.astro';
import TryIt from './TryIt.astro';
import Work from './Work.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
---

<Nav locale={locale} />

<main>
  <Hero locale={locale} />
  <Marquee items={c.stack} label="Stack" />

  <Pains locale={locale} />

  <Work locale={locale} />

  <TryIt locale={locale} />

  <Method locale={locale} />
  <About locale={locale} />
  <Contact locale={locale} />
</main>

<Footer locale={locale} />

<script>
  import { initMotion } from '../scripts/motion';

  initMotion(document);
</script>
