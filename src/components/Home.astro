---
// Page body. Try it is plain until its task builds it.
import { getContent } from '../content';
import type { Locale } from '../i18n/locales';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Method from './Method.astro';
import Nav from './Nav.astro';
import Pains from './Pains.astro';
import Work from './Work.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
---

<Nav locale={locale} />

<main>
  <Hero locale={locale} />
  <Marquee items={c.stack} label="Stack" />

  <Pains locale={locale} />

  <Work locale={locale} />

  <section id="try">
    <p>{c.tryIt.eyebrow}</p>
    <h2>{c.tryIt.title}</h2>
    <p>{c.tryIt.lead}</p>
    {
      c.work.projects.map((p) => (
        <div id={`demo-${p.id}`}>
          <h3>{p.tab}</h3>
          <ul>{c.tryIt.hints[p.id].map((h) => <li>{h}</li>)}</ul>
          <p>{c.tryIt.fakeNote[p.id]}</p>
        </div>
      ))
    }
  </section>

  <Method locale={locale} />
  <About locale={locale} />
  <Contact locale={locale} />
</main>

<Footer locale={locale} />
