---
// The device a demo lives in: a phone, or a browser window with an address label.
interface Props {
  variant: 'phone' | 'browser';
  /** text in the browser's address bar */
  label?: string;
}

const { variant, label } = Astro.props;
---

{
  variant === 'phone' ? (
    <div class="phone">
      <div class="phone__screen">
        <slot />
      </div>
    </div>
  ) : (
    <div class="browser">
      <div class="browser__bar" aria-hidden="true">
        <i />
        <i />
        <i />
        {label && <span>{label}</span>}
      </div>
      <div class="browser__page">
        <slot />
      </div>
    </div>
  )
}

<style>
  .phone {
    width: min(22.5rem, 100%);
    margin-inline: auto;
    padding: 10px;
    border-radius: 38px;
    background: #0e1311;
    box-shadow: 0 30px 60px -30px rgb(23 32 27 / 0.45);
  }

  .phone__screen {
    position: relative;
    height: 40rem;
    max-height: 78vh;
    min-height: 30rem;
    overflow: hidden;
    border-radius: 30px;
    background: #fff;
  }

  .browser {
    width: 100%;
    overflow: hidden;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 12px;
    background: #e3e7ee;
    box-shadow: 0 30px 60px -34px rgb(23 32 27 / 0.45);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 12px;
  }

  .browser__bar i {
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .browser__bar i:nth-child(2) {
    background: #febc2e;
  }

  .browser__bar i:nth-child(3) {
    background: #28c840;
  }

  .browser__bar span {
    flex: 1;
    max-width: 320px;
    margin-left: 10px;
    padding: 5px 10px;
    overflow: hidden;
    border-radius: 6px;
    background: #fff;
    color: #5b6573;
    font: 12px/1 var(--font-mono);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .browser__page {
    min-height: 32.5rem;
    background: #f6f7f9;
    color: #1a2333;
    font: 14px/1.45 var(--font-body);
  }
</style>
