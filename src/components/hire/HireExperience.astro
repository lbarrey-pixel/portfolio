---
// Portrait treatment from the sales About section, then the roles, kept short.
import { Picture } from 'astro:assets';
import portrait from '../../assets/photo/leonardo-portrait.jpg';
import hire from '../../content/hire';

const { experience } = hire;
---

<section id="experience" class="section about">
  <div class="wrap about__inner">
    <figure class="about__photo" data-reveal>
      <Picture
        src={portrait}
        alt={experience.photoAlt}
        formats={['avif', 'webp']}
        widths={[240, 384]}
        sizes="(min-width: 48rem) 240px, 45vw"
        loading="lazy"
      />
    </figure>
    <div class="about__body" data-reveal style="--n:1">
      <h2 class="section__tag">{experience.eyebrow}</h2>
      <p class="about__title">{experience.title}</p>
      <p class="about__text">{experience.text}</p>
    </div>

    <dl class="roles">
      {
        experience.roles.map((role) => (
          <div>
            <dt>{role.label}</dt>
            <dd>{role.detail}</dd>
          </div>
        ))
      }
    </dl>

    <div class="also" data-reveal>
      <p class="section__tag">{experience.also.label}</p>
      <p class="also__text">{experience.also.text}</p>
      <a class="btn btn--ghost" href={experience.also.href} target="_blank" rel="noopener noreferrer">
        {experience.also.repoLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--line);
    padding-block: var(--space-8);
  }

  .about__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-5);
    row-gap: var(--space-6);
    align-items: end;
  }

  .about__photo {
    grid-column: 1 / span 2;
    position: relative;
    max-width: 11rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--card);
  }

  .about__photo :global(img) {
    width: 100%;
    height: auto;
    filter: saturate(0.6) sepia(0.16) contrast(1.03);
  }

  .about__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--acc);
    mix-blend-mode: color;
    opacity: 0.18;
    pointer-events: none;
  }

  .about__body {
    grid-column: 3 / span 9;
    display: grid;
    gap: var(--space-3);
    align-content: end;
  }

  .about__title {
    font: 500 var(--step-3) / 1.05 var(--font-body);
    letter-spacing: -0.03em;
  }

  .about__text {
    max-width: 62ch;
    font: 400 var(--step-1) / 1.4 var(--font-body);
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .roles {
    grid-column: 1 / -1;
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .roles > div {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    column-gap: var(--space-5);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .roles dt {
    font: italic 400 var(--step-1) / 1.1 var(--font-display);
    color: var(--acc);
  }

  .roles dd {
    color: var(--mute);
  }

  .also {
    grid-column: 1 / -1;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 68ch;
  }

  .also__text {
    color: var(--mute);
  }

  @media (max-width: 63.99rem) {
    .about__photo {
      grid-column: 1 / span 3;
    }

    .about__body {
      grid-column: 4 / -1;
    }
  }

  @media (max-width: 39.99rem) {
    .about {
      padding-block: var(--space-7);
    }

    .about__photo {
      grid-column: 1 / -1;
      max-width: 8rem;
    }

    .about__body {
      grid-column: 1 / -1;
    }

    .about__text {
      font-size: 1.125rem;
    }

    .roles > div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-1);
    }
  }
</style>
