---
// A slow, endless band of words. Only the first list is real; the copies exist to fill the
// width and close the loop, and are hidden from assistive tech.
type Item = string | { text: string; lang?: string };

interface Props {
  items: Item[];
  label?: string;
  size?: 'md' | 'lg';
  /** Copies of the list per half. Raise it when the items are too few to span a wide screen. */
  repeat?: number;
}

const { items, label, size = 'md', repeat = 1 } = Astro.props;
const list = items.map((item) => (typeof item === 'string' ? { text: item } : item));
const copies = Array.from({ length: repeat * 2 }, (_, i) => i);
---

<div class={`marquee marquee--${size}`} role="region" aria-label={label}>
  <div class="marquee__track">
    {
      copies.map((i) => (
        <ul class="marquee__list" aria-hidden={i > 0 ? 'true' : undefined}>
          {list.map((item) => (
            <li lang={item.lang}>{item.text}</li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: var(--space-4);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__list {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee__list li {
    display: flex;
    align-items: center;
    font: italic 400 var(--step-2) / 1.1 var(--font-display);
    color: var(--ink);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .marquee__list li::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-inline: var(--space-6);
    border: 1px solid var(--acc);
    border-radius: 50%;
  }

  .marquee--lg {
    padding-block: var(--space-5);
  }

  .marquee--lg .marquee__track {
    animation-duration: 60s;
  }

  .marquee--lg .marquee__list li {
    font-size: clamp(3rem, 1.4rem + 7vw, 7.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--acc);
  }

  .marquee--lg .marquee__list li::after {
    width: 0.14em;
    height: 0.14em;
    margin-inline: 0.45em;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Static: show every word once, wrapped. */
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .marquee__track {
      width: auto;
      animation: none;
    }

    .marquee__list {
      flex-wrap: wrap;
      flex-shrink: 1;
      justify-content: center;
      row-gap: var(--space-2);
    }

    .marquee__list[aria-hidden] {
      display: none;
    }
  }
</style>
