---
// Work: "every system is a flow". Scrolling draws the line and lights each step; tabs switch
// between the four projects; below the stage, the active project's details and screenshots.
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { getContent, type Metric } from '../content';
import type { Locale } from '../i18n/locales';
import { FLOW_NODES, FLOW_VIEW, flowPathD } from '../lib/flow';
import { formatNumber } from '../lib/format';
import Lightbox from './Lightbox.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const projects = c.work.projects;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.jpg', { eager: true });
const source = (file: string) => files[`../assets/projects/${file}`].default;

// Thumbnails go through <Image>; the lightbox gets one larger webp per screenshot.
const galleries = await Promise.all(
  projects.map((p) =>
    Promise.all(
      p.images.map(async (img) => {
        const src = source(img.file);
        const full = await getImage({ src, format: 'webp', width: Math.min(src.width, 1600) });
        return { ...img, src, full: full.src, width: full.attributes.width, height: full.attributes.height };
      }),
    ),
  ),
);

const metricText = (m: Metric) => `${m.prefix ?? ''}${formatNumber(m.value, locale)}${m.suffix ?? ''}`;
const pathD = flowPathD();
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---

<section id="work" class="section work" data-work>
  <div class="wrap">
    <header class="section__head">
      <p class="section__tag">{c.work.eyebrow}</p>
      <h2 class="section__title" data-reveal-lines>{c.work.title}</h2>
      <p class="section__lead" data-reveal>{c.work.lead}</p>
    </header>
  </div>

  <div class="work__scroller" data-flow-scroller>
    <div class="work__stage" data-flow-stage>
      <div class="wrap work__stage-inner">
        <div class="work__bar">
          <div class="work__tabs" role="tablist" aria-label={c.work.eyebrow}>
            {
              projects.map((p, i) => (
                <button
                  type="button"
                  role="tab"
                  class="work__tab"
                  id={`work-tab-${p.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`project-${p.id}`}
                  tabindex={i === 0 ? 0 : -1}
                  data-project-tab={p.id}
                >
                  {p.tab}
                </button>
              ))
            }
          </div>
          <p class="work__hint" aria-hidden="true">{c.work.progressHint}</p>
        </div>

        {
          projects.map((p, i) => (
            <div
              class="project"
              id={`project-${p.id}`}
              role="tabpanel"
              aria-labelledby={`work-tab-${p.id}`}
              data-project-panel={p.id}
              hidden={i !== 0}
            >
              <div class="project__intro">
                <p class="project__kind">
                  <span>{p.kind}</span>
                  <span class="project__status">
                    <span class="project__pulse" aria-hidden="true" />
                    {p.status}
                  </span>
                </p>
                <h3 class="project__title">{p.title}</h3>
                <p class="project__summary">{p.summary}</p>
              </div>

              <div class="flow" data-flow>
                <svg
                  class="flow__svg"
                  viewBox={`0 0 ${FLOW_VIEW.w} ${FLOW_VIEW.h}`}
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path d={pathD} />
                </svg>
                <svg
                  class="flow__svg flow__svg--on"
                  viewBox={`0 0 ${FLOW_VIEW.w} ${FLOW_VIEW.h}`}
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path d={pathD} />
                </svg>
                <span class="flow__rail" aria-hidden="true" />
                <span class="flow__marker" aria-hidden="true" />
                <ol class="flow__nodes">
                  {p.steps.map((s, n) => (
                    <li
                      class:list={['flow__node', n % 2 ? 'flow__node--below' : 'flow__node--above', n === 0 && 'is-on is-current']}
                      style={`--x:${pct(FLOW_NODES[n].x, FLOW_VIEW.w)};--y:${pct(FLOW_NODES[n].y, FLOW_VIEW.h)}`}
                      data-flow-node
                    >
                      <span class="flow__dot" aria-hidden="true" />
                      <span class="flow__label">
                        <span class="flow__code">{s.code}</span>
                        <span class="flow__title">{s.title}</span>
                        <span class="flow__tech">{s.tech}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              </div>

              <dl class="project__metrics">
                {p.metrics.map((m) => (
                  <div class="metric" data-metric>
                    <dt class="metric__value">
                      <span data-count={m.value} data-prefix={m.prefix} data-suffix={m.suffix}>
                        {metricText(m)}
                      </span>
                    </dt>
                    <dd class="metric__label">{m.label}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="wrap">
    {
      projects.map((p, i) => (
        <div class="detail" data-project-detail={p.id} hidden={i !== 0}>
          <div class="detail__facts">
            <dl class="detail__bullets">
              {p.bullets.map((b) => (
                <div>
                  <dt class="accent">{b.label}</dt>
                  <dd>{b.text}</dd>
                </div>
              ))}
            </dl>
            <ul class="detail__tags">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <a class="btn btn--ghost detail__try" href={`#demo-${p.id}`} data-magnetic>
              {p.tryLabel}
            </a>
          </div>

          <ul class:list={['detail__shots', galleries[i].length === 1 && 'detail__shots--single']}>
            {galleries[i].map((img, n) => (
              <li>
                <button
                  type="button"
                  class="shot"
                  data-gallery={p.id}
                  data-index={n}
                  data-full={img.full}
                  data-width={img.width}
                  data-height={img.height}
                  data-alt={img.alt}
                  data-caption={img.caption}
                >
                  <Image
                    src={img.src}
                    alt={img.alt}
                    widths={[480, 800, Math.min(img.src.width, 1200)]}
                    sizes={galleries[i].length === 1 ? '(min-width: 64rem) 52vw, 92vw' : '(min-width: 64rem) 26vw, 46vw'}
                    loading="lazy"
                  />
                  <span class="shot__caption">{img.caption}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <Lightbox locale={locale} />
</section>

<script>
  import { initFlow } from '../scripts/flow';

  document.querySelectorAll<HTMLElement>('[data-work]').forEach(initFlow);
</script>

<style>
  .work {
    /* position: sticky needs no clipping ancestor */
    overflow: visible;
  }

  /* ---------- stage ---------- */

  .work__stage {
    border-block: 1px solid var(--line);
    background: var(--card);
  }

  .work__stage-inner {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-5) var(--space-6);
  }

  .work__bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .work__tabs {
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .work__tabs::-webkit-scrollbar {
    display: none;
  }

  .work__tab {
    position: relative;
    flex: none;
    min-height: 3rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--mute);
    font: 500 var(--step-0) / 1 var(--font-body);
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.3s var(--ease-out);
  }

  .work__tab::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--acc);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.5s var(--ease-out);
  }

  .work__tab:hover,
  .work__tab[aria-selected='true'] {
    color: var(--ink);
  }

  .work__tab[aria-selected='true']::after {
    scale: 1 1;
  }

  .work__tab:focus-visible {
    outline-offset: -2px;
  }

  .work__hint {
    flex: none;
    font: 400 var(--step--2) / 1.2 var(--font-mono);
    color: var(--mute);
  }

  /* ---------- one project ---------- */

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-top: var(--space-5);
    animation: project-in 0.7s var(--ease-out) both;
  }

  .project[hidden] {
    display: none;
  }

  @keyframes project-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .project__kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    font: 400 var(--step--1) / 1.4 var(--font-mono);
    color: var(--mute);
  }

  .project__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--acc);
  }

  .project__pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--acc-live);
    animation: pulse 2.4s var(--ease-in-out) infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .project__title {
    margin-top: var(--space-3);
    font: 500 var(--step-2) / 1.08 var(--font-body);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .project__summary {
    margin-top: var(--space-3);
    max-width: 52ch;
    color: var(--mute);
  }

  .project__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .metric {
    padding-top: var(--space-3);
    border-top: 1px solid var(--ink);
  }

  .metric__value {
    font: italic 400 var(--step-3) / 1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--acc);
    font-variant-numeric: tabular-nums;
  }

  .metric__label {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--mute);
  }

  /* ---------- the flow (phone first: a vertical rail) ---------- */

  .flow {
    --f: 0.1; /* how far the data has travelled, 0..1 (set by the script) */
    --my: 36.67;
    position: relative;
  }

  .flow__svg {
    display: none;
  }

  .flow__rail {
    position: absolute;
    left: 0.3125rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(var(--acc), var(--acc)) 0 0 / 100% calc(var(--f) * 100%) no-repeat, var(--line);
  }

  .flow__marker {
    position: absolute;
    left: 0.3125rem;
    top: calc(var(--f) * 100%);
    z-index: 2;
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
    background: var(--acc);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--acc) 18%, transparent);
    translate: -50% -50%;
  }

  .flow__nodes {
    display: grid;
    grid-auto-rows: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow__node {
    display: flex;
    align-items: center;
    min-height: 4.75rem;
    padding-left: var(--space-6);
  }

  .flow__dot {
    position: absolute;
    left: 0.3125rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--mute);
    translate: -50% 0;
    transition:
      background-color 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
  }

  .flow__label {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    opacity: 0.45;
    transition: opacity 0.7s var(--ease-out);
  }

  .flow__code {
    font: 400 var(--step--2) / 1.2 var(--font-mono);
    color: var(--mute);
  }

  .flow__title {
    font: 500 var(--step-0) / 1.15 var(--font-body);
    letter-spacing: -0.015em;
  }

  .flow__tech {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: 400 var(--step--2) / 1.2 var(--font-mono);
    color: var(--mute);
    transition:
      border-color 0.6s var(--ease-out),
      background-color 0.6s var(--ease-out),
      color 0.6s var(--ease-out);
  }

  .flow__node:global(.is-on) .flow__label {
    opacity: 1;
  }

  .flow__node:global(.is-on) .flow__dot {
    background: var(--acc);
    box-shadow: 0 0 0 1px var(--acc);
  }

  .flow__node:global(.is-on) .flow__code {
    color: var(--acc);
  }

  .flow__node:global(.is-on) .flow__tech {
    border-color: var(--acc);
    background: var(--acc-soft);
    color: var(--acc);
  }

  .flow__node:global(.is-current) .flow__tech {
    background: var(--acc);
    color: var(--on-acc);
  }

  /* ---------- details under the stage ---------- */

  .detail {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-5);
    row-gap: var(--space-6);
    align-items: start;
    padding-top: var(--space-7);
    animation: project-in 0.7s var(--ease-out) both;
  }

  .detail[hidden] {
    display: none;
  }

  .detail__facts {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .detail__bullets {
    width: 100%;
    border-top: 1px solid var(--ink);
  }

  .detail__bullets > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .detail__bullets dt {
    font-size: var(--step-1);
    line-height: 1.1;
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail__tags li {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: 400 var(--step--2) / 1.2 var(--font-mono);
    color: var(--mute);
  }

  .detail__shots {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail__shots--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: zoom-in;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    transition: border-color 0.4s var(--ease-out);
  }

  .shot:hover :global(img) {
    border-color: var(--acc);
  }

  .shot__caption {
    display: block;
    margin-top: var(--space-2);
    font: 400 var(--step--1) / 1.4 var(--font-mono);
    color: var(--mute);
  }

  @media (max-width: 39.99rem) {
    .work__hint {
      display: none;
    }

    .project__metrics {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .metric {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: baseline;
      padding-block: var(--space-3);
      border-top: 1px solid var(--line);
    }

    .metric:first-child {
      border-top-color: var(--ink);
    }

    .metric__value {
      font-size: var(--step-2);
    }

    .metric__label {
      margin-top: 0;
    }

    .detail__bullets > div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-1);
    }
  }

  /* ---------- wide and tall enough: the stage pins and the line runs left to right ---------- */

  @media (min-width: 64rem) and (min-height: 42rem) {
    .work__scroller {
      height: 280vh;
    }

    .work__stage {
      position: sticky;
      top: var(--nav-h);
      height: calc(100vh - var(--nav-h));
      height: calc(100svh - var(--nav-h));
    }

    .work__stage-inner {
      height: 100%;
    }

    .project {
      flex: 1;
      min-height: 0;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto minmax(0, 1fr);
      column-gap: var(--space-5);
      row-gap: var(--space-4);
    }

    .project__intro {
      grid-column: 1 / span 7;
    }

    .project__metrics {
      grid-column: 9 / -1;
      grid-template-columns: minmax(0, 1fr);
      align-content: end;
      gap: var(--space-3);
    }

    .metric {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: baseline;
    }

    .metric__label {
      margin-top: 0;
    }

    .flow {
      grid-column: 1 / -1;
      grid-row: 2;
      min-height: 15rem;
    }

    .flow__rail {
      display: none;
    }

    .flow__svg {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .flow__svg path {
      fill: none;
      stroke: var(--line);
      stroke-width: 1.5;
      vector-effect: non-scaling-stroke;
    }

    /* The travelled part of the line: the same path in the accent, revealed from the left. */
    .flow__svg--on {
      clip-path: inset(-1rem calc((1 - var(--f)) * 100%) -1rem 0);
    }

    .flow__svg--on path {
      stroke: var(--acc);
    }

    .flow__marker {
      left: calc(var(--f) * 100%);
      top: calc(var(--my) * 1%);
    }

    .flow__nodes {
      display: block;
      position: absolute;
      inset: 0;
    }

    .flow__node {
      position: absolute;
      left: var(--x);
      top: var(--y);
      display: block;
      min-height: 0;
      padding: 0;
    }

    .flow__dot {
      left: 0;
      top: 0;
      translate: -50% -50%;
    }

    .flow__label {
      position: absolute;
      left: 0;
      width: 11.5rem;
      translate: -1.5rem 0;
    }

    .flow__node--above .flow__label {
      bottom: 1.1rem;
    }

    .flow__node--below .flow__label {
      top: 1.1rem;
    }

    .flow__node:last-child .flow__label {
      width: 9.5rem;
    }

    .detail__facts {
      grid-column: 1 / span 5;
    }

    .detail__shots {
      grid-column: 7 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No pinned scroll stage: the flow is simply shown complete. */
    .work__scroller {
      height: auto;
    }

    .work__stage {
      position: static;
      height: auto;
    }

    .work__hint {
      display: none;
    }

    .project__pulse {
      animation: none;
    }
  }
</style>
