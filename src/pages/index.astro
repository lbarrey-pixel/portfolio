---
// Root: send the visitor to their saved or browser language.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Leonardo Barrey</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="pt-BR" href="/pt-br/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <script>
      import { localePath, readSavedLocale, resolveLocale } from '../i18n/locales';

      let storage: Storage | null = null;
      try {
        storage = window.localStorage;
      } catch {
        storage = null;
      }
      location.replace(localePath(resolveLocale(readSavedLocale(storage), navigator.languages)));
    </script>
  </head>
  <body>
    <noscript>
      <p><a href="/en/" hreflang="en">English</a> · <a href="/pt-br/" hreflang="pt-BR" lang="pt-BR">Português</a></p>
    </noscript>
  </body>
</html>
